<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Now or Never</string>
	<key>NSMotionUsageDescription</key>
	<string>Now or Never cuenta tus pasos de hoy con el sensor de movimiento del iPhone para enseñártelos en Inicio, guardar tu historial y avisarte si vas por debajo de la mitad de tu objetivo. No se envían a ningún sitio.</string>
	<key>NSCameraUsageDescription</key>
	<string>Now or Never usa la cámara para hacer tus fotos mensuales de progreso (frente, lateral y espalda). Se guardan solo en tu iPhone.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>strava</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nowornever</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>now-or-never.reminders.refresh</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
