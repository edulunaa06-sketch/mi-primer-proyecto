<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>ATLAS</string>
	<key>NSMotionUsageDescription</key>
	<string>ATLAS cuenta tus pasos con el sensor de movimiento del iPhone para enseñártelos en Hoy. No salen de tu iPhone.</string>
	<key>NSCameraUsageDescription</key>
	<string>ATLAS usa la cámara para escanear el código de barras de los alimentos y para tus fotos de progreso. Nada sale de tu iPhone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ATLAS usa tus fotos solo si eliges una foto de progreso. Se guarda dentro de la app, en tu iPhone.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>strava</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>atlas</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
